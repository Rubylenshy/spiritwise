# Backend origin — the root, WITHOUT a trailing /api.
#
# Leave this unset for local dev: URLs stay relative and go through the Vite
# proxy in vite.config.js, which avoids CORS entirely.
#
# Set it for any build that is served without that proxy (Vercel, Netlify,
# `npm run preview`). The backend must then list that frontend origin in its
# CORS_ALLOWED_ORIGINS.
#
# VITE_API_BASE_URL=https://spiritwise-backend.fly.dev

# OAuth 2.0 Web client ID for "Sign in with Google" — the same ID the backend
# has as GOOGLE_OAUTH_CLIENT_ID. Add every frontend origin (http://localhost:5173,
# the Vercel URL) under "Authorized JavaScript origins" in Google Cloud Console.
# Unset hides the Google button. Inlined at build time, like VITE_API_BASE_URL.
#
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
