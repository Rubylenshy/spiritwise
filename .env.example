# Backend origin — the root, WITHOUT a trailing /api.
#
# Leave this unset for local dev: URLs stay relative and go through the Vite
# proxy in vite.config.js, which avoids CORS entirely.
#
# Set it for any build that is served without that proxy (Vercel, Netlify,
# `npm run preview`). The backend must then list that frontend origin in its
# CORS_ALLOWED_ORIGINS.
#
# VITE_API_BASE_URL=https://spiritwise-backend.fly.dev

# Optional key for signing persisted app state in localStorage (see
# src/lib/jwtStorage.js). It ships in the bundle, so it only deters casual
# edits. Changing it signs everyone out once, because their stored state no
# longer verifies.
# VITE_STORAGE_JWT_SECRET=
