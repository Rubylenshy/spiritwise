{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://spiritwise-backend.fly.dev/api/:path*" },
    { "source": "/admin/:path*", "destination": "https://spiritwise-backend.fly.dev/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://spiritwise-backend.fly.dev/static/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
